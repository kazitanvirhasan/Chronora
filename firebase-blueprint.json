{
  "entities": {
    "User": {
      "title": "User",
      "description": "A user profile in the study app.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "avatar": { "type": "string" },
        "bio": { "type": "string" },
        "xp": { "type": "number" },
        "level": { "type": "number" },
        "totalStudyTime": { "type": "number" },
        "currentStreak": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "subjects": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["uid", "name", "email", "xp", "level", "totalStudyTime", "currentStreak"]
    },
    "Task": {
      "title": "Task",
      "description": "A to-do item for a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" },
        "priority": { "type": "string", "enum": ["low", "medium", "high"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "completed", "priority", "createdAt"]
    },
    "Note": {
      "title": "Note",
      "description": "A study note created by a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "subject": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "content", "subject", "createdAt"]
    },
    "StudySession": {
      "title": "StudySession",
      "description": "A recorded study session.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "duration": { "type": "number", "description": "Duration in seconds" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": "string", "format": "date-time" },
        "subject": { "type": "string" }
      },
      "required": ["userId", "duration", "startTime", "endTime", "subject"]
    },
    "Group": {
      "title": "Group",
      "description": "A study group.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "members": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description", "members", "createdBy", "createdAt"]
    },
    "GroupMessage": {
      "title": "GroupMessage",
      "description": "A message in a study group chat.",
      "type": "object",
      "properties": {
        "groupId": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "userId", "text", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "User tasks"
    },
    "/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "User notes"
    },
    "/studySessions/{sessionId}": {
      "schema": { "$ref": "#/entities/StudySession" },
      "description": "User study sessions"
    },
    "/groups/{groupId}": {
      "schema": { "$ref": "#/entities/Group" },
      "description": "Study groups"
    },
    "/groupMessages/{messageId}": {
      "schema": { "$ref": "#/entities/GroupMessage" },
      "description": "Messages in study groups"
    }
  }
}
